<h1><%= @enrollment.student.full_name %></h1>
<p class="text-muted">Grades in <%= @course.code %>: <%= @course.name %> (<%= @course.semester %>)</p>

<%= link_to "Add grade", new_course_enrollment_grade_path(@course, @enrollment), class: "btn btn-primary mb-3" %>

<% if @grades.any? %>
  <table class="table table-striped align-middle">
    <thead>
      <tr>
        <th>Assessment</th>
        <th>Weight</th>
        <th>Score</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @grades.each do |grade| %>
        <tr>
          <td><%= grade.assessment_item.title %></td>
          <td><%= number_to_percentage(grade.assessment_item.weight * 100, precision: 1, strip_insignificant_zeros: true) %></td>
          <td><%= grade.score %></td>
          <td class="text-end">
            <%= link_to "Edit", edit_course_enrollment_grade_path(@course, @enrollment, grade), class: "btn btn-sm btn-outline-secondary" %>
            <%= button_to "Delete", course_enrollment_grade_path(@course, @enrollment, grade), method: :delete,
                  class: "btn btn-sm btn-outline-danger",
                  form: { style: "display:inline", data: { turbo_confirm: "Delete this grade?" } } %>
          </td>
        </tr>
      <% end %>
    </tbody>
    <tfoot>
      <tr>
        <th colspan="2">Overall grade</th>
        <th><%= @enrollment.overall_grade %></th>
        <th></th>
      </tr>
    </tfoot>
  </table>
<% else %>
  <p>No grades yet.</p>
<% end %>

<%= link_to "Back to roster", course_enrollments_path(@course) %>