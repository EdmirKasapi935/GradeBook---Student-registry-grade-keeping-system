<h1>Add grade for <%= @enrollment.student.full_name %></h1>
<p class="text-muted"><%= @course.code %>, <%= @course.semester %></p>

<% if @available_items.any? %>
  <%= render "form", grade: @grade %>
<% else %>
  <div class="alert alert-info">
    This student already has a grade for every assessment item, or the course has no assessment items yet.
  </div>
<% end %>

<%= link_to "Back to grades", course_enrollment_grades_path(@course, @enrollment), class: "d-inline-block mt-3" %>