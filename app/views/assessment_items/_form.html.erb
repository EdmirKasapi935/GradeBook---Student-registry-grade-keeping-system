<div class="col-md-6">
  <% if assessment_item.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% assessment_item.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: [@course, assessment_item] do |f| %>
    <div class="mb-3">
      <%= f.label :title, class: "form-label" %>
      <%= f.text_field :title, class: "form-control", placeholder: "Midterm" %>
    </div>
    <div class="mb-3">
      <%= f.label :weight, class: "form-label" %>
      <%= f.number_field :weight, step: 0.01, min: 0, max: 1, class: "form-control", placeholder: "0.20" %>
      <div class="form-text">A number between 0 and 1, e.g. 0.2 for 20%.</div>
    </div>
    <%= f.submit "Save", class: "btn btn-primary" %>
  <% end %>
</div>