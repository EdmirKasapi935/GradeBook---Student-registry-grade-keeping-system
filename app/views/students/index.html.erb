<div class="d-flex justify-content-between align-items-center mb-3">
  <h1>Students</h1>
  <%= link_to "New student", new_student_path, class: "btn btn-primary" %>
</div>

<% if @students.any? %>
  <table class="table table-striped align-middle">
    <thead>
      <tr>
        <th>Name</th>
        <th>Surname</th>
        <th>Email</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @students.each do |student| %>
        <tr>
          <td><%= student.name %></td>
          <td><%= student.surname %></td>
          <td><%= student.email_address %></td>
          <td class="text-end">
            <%= link_to "View", student_path(student), class: "btn btn-sm btn-outline-primary" %>
            <%= link_to "Edit", edit_student_path(student), class: "btn btn-sm btn-outline-secondary" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No students yet.</p>
<% end %>

<%= link_to "Back to dashboard", instructor_dashboard_path %>