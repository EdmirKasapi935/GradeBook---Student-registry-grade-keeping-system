<h1><%= @student.full_name %></h1>
<p class="text-muted"><%= @student.email_address %></p>

<h5 class="mt-4">Enrolled courses</h5>
<% if @student.courses.any? %>
  <ul>
    <% @student.courses.each do |course| %>
      <li><%= course.code %>: <%= course.name %> (<%= course.semester %>)</li>
    <% end %>
  </ul>
<% else %>
  <p>Not enrolled in any courses.</p>
<% end %>

<div class="d-flex gap-2 mt-4">
  <%= link_to "Edit", edit_student_path(@student), class: "btn btn-secondary" %>
  <%= button_to "Delete", student_path(@student), method: :delete, class: "btn btn-danger",
        form: { data: { turbo_confirm: "Delete this student and all their enrollments?" } } %>
  <%= link_to "Back to students", students_path, class: "btn btn-link" %>
</div>