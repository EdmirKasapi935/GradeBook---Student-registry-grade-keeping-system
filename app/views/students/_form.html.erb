<div class="col-md-6">
  <% if student.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% student.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: student, url: (student.persisted? ? student_path(student) : students_path) do |f| %>
    <div class="mb-3">
      <%= f.label :name, class: "form-label" %>
      <%= f.text_field :name, class: "form-control" %>
    </div>
    <div class="mb-3">
      <%= f.label :surname, class: "form-label" %>
      <%= f.text_field :surname, class: "form-control" %>
    </div>
    <div class="mb-3">
      <%= f.label :email_address, "Email", class: "form-label" %>
      <%= f.email_field :email_address, class: "form-control" %>
    </div>
    <div class="mb-3">
      <%= f.label :password, class: "form-label" %>
      <%= f.password_field :password, class: "form-control" %>
      <% if student.persisted? %>
        <div class="form-text">Leave blank to keep the current password.</div>
      <% end %>
    </div>
    <div class="mb-3">
      <%= f.label :password_confirmation, "Confirm password", class: "form-label" %>
      <%= f.password_field :password_confirmation, class: "form-control" %>
    </div>
    <%= f.submit "Save", class: "btn btn-primary" %>
  <% end %>
</div>