<div class="row justify-content-center">
  <div class="col-md-4">
    <h1 class="h3 mb-3">Log in</h1>
    <%= form_with url: session_path do |form| %>
      <div class="mb-3">
        <%= form.label :email_address, "Email", class: "form-label" %>
        <%= form.email_field :email_address, required: true, autofocus: true,
              value: params[:email_address], class: "form-control" %>
      </div>
      <div class="mb-3">
        <%= form.label :password, class: "form-label" %>
        <%= form.password_field :password, required: true, class: "form-control" %>
      </div>
      <%= form.submit "Log in", class: "btn btn-primary w-100" %>
    <% end %>
  </div>
</div>