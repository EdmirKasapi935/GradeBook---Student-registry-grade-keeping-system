<h1><%= @course.code %>: <%= @course.name %></h1>
<p class="text-muted"><%= @course.semester %> · Roster</p>

<h5 class="mt-4">Add a student</h5>
<% if @available_students.any? %>
  <%= form_with url: course_enrollments_path(@course), class: "row g-2 mb-4" do |f| %>
    <div class="col-auto">
      <%= f.select :student_id,
            @available_students.map { |s| [s.full_name, s.id] },
            { prompt: "Select a student" },
            class: "form-select" %>
    </div>
    <div class="col-auto">
      <%= f.submit "Add to course", class: "btn btn-primary" %>
    </div>
  <% end %>
<% else %>
  <p>All students are already enrolled in this course.</p>
<% end %>

<h5>Enrolled students (<%= @total_count %>)</h5>
<% if @enrollments.any? %>
  <div class="table-responsive">
    <table class="table table-striped align-middle">
      <thead>
        <tr>
          <th>Name</th>
          <th>Email</th>
          <% @assessment_items.each do |item| %>
            <th class="text-center">
              <%= item.title %><br>
              <small class="text-muted"><%= number_to_percentage(item.weight * 100, precision: 1, strip_insignificant_zeros: true) %></small>
            </th>
          <% end %>
          <th class="text-center">Overall</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @enrollments.each do |enrollment| %>
          <% grades_by_item = enrollment.grades.index_by(&:assessment_item_id) %>
          <tr>
            <td><%= enrollment.student.full_name %></td>
            <td><%= enrollment.student.email_address %></td>
            <% @assessment_items.each do |item| %>
              <td class="text-center">
                <%= grades_by_item[item.id]&.score || content_tag(:span, "–", class: "text-muted") %>
              </td>
            <% end %>
            <td class="text-center"><strong><%= enrollment.overall_grade %></strong></td>
            <td class="text-end text-nowrap">
              <%= link_to "Grades", course_enrollment_grades_path(@course, enrollment), class: "btn btn-sm btn-outline-primary" %>
              <%= button_to "Remove", course_enrollment_path(@course, enrollment), method: :delete,
                    class: "btn btn-sm btn-outline-danger",
                    form: { style: "display:inline", data: { turbo_confirm: "Remove this student from the course?" } } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <%= render "shared/pagination" %>
<% else %>
  <p>No students enrolled yet.</p>
<% end %>

<%= link_to "Back to course", course_path(@course) %>