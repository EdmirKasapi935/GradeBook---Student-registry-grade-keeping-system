<h1 class="mb-4">Courses offered</h1>

<% if @courses.any? %>
  <table class="table table-striped">
    <thead>
      <tr>
        <th>Code</th>
        <th>Name</th>
        <th>Semester</th>
        <th>Enrolled students</th>
      </tr>
    </thead>
    <tbody>
      <% @courses.each do |course| %>
        <tr>
          <td><%= course.code %></td>
          <td><%= course.name %></td>
          <td><%= course.semester %></td>
          <td><%= course.enrollments.size %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No courses yet.</p>
<% end %>
