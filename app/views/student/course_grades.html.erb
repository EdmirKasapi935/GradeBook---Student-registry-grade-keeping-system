<h1><%= @course.code %>: <%= @course.name %></h1>
<p class="text-muted"><%= @course.semester %></p>

<% if @assessment_items.any? %>
  <table class="table table-striped align-middle">
    <thead>
      <tr>
        <th>Assessment</th>
        <th>Weight</th>
        <th>Your score</th>
      </tr>
    </thead>
    <tbody>
      <% @assessment_items.each do |item| %>
        <% grade = @grades_by_item[item.id] %>
        <tr>
          <td><%= item.title %></td>
          <td><%= number_to_percentage(item.weight * 100, precision: 1, strip_insignificant_zeros: true) %></td>
          <td>
            <% if grade %>
              <%= grade.score %>
            <% else %>
              <span class="text-muted">Not graded yet</span>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
    <tfoot>
      <tr>
        <th colspan="2">Overall grade</th>
        <th><%= @enrollment.overall_grade %></th>
      </tr>
    </tfoot>
  </table>
<% else %>
  <p>Your instructor hasn't set up any assessments for this course yet.</p>
<% end %>

<%= link_to "Back to my courses", student_dashboard_path %>