<h1 class="mb-1">Welcome, <%= Current.user.name %></h1>
<p class="text-muted mb-4">Your courses and overall grades.</p>

<% if @enrollments.any? %>
  <table class="table table-striped align-middle">
    <thead>
      <tr>
        <th>Code</th>
        <th>Course</th>
        <th>Semester</th>
        <th>Overall grade</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @enrollments.each do |enrollment| %>
        <tr>
          <td><%= enrollment.course.code %></td>
          <td><%= enrollment.course.name %></td>
          <td><%= enrollment.course.semester %></td>
          <td><strong><%= enrollment.overall_grade %></strong></td>
          <td class="text-end">
            <%= link_to "View grades", student_course_path(enrollment.course), class: "btn btn-sm btn-outline-primary" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>You are not enrolled in any courses yet.</p>
<% end %>