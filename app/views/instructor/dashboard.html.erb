<h1 class="mb-1">Welcome, <%= Current.user.name %></h1>
<p class="text-muted mb-4">What would you like to do?</p>

<div class="row g-3">
  <div class="col-md-6 col-lg-3">
    <div class="card h-100">
      <div class="card-body">
        <h5 class="card-title">Courses</h5>
        <p class="card-text text-muted">You have <%= @course_count %> course(s). Manage rosters, assessment items and grades.</p>
        <%= link_to "Go to courses", courses_path, class: "btn btn-primary" %>
      </div>
    </div>
  </div>

  <div class="col-md-6 col-lg-3">
    <div class="card h-100">
      <div class="card-body">
        <h5 class="card-title">Students</h5>
        <p class="card-text text-muted"><%= @student_count %> student(s) registered. Add, edit or remove students.</p>
        <%= link_to "Go to students", students_path, class: "btn btn-primary" %>
      </div>
    </div>
  </div>

  <div class="col-md-6 col-lg-3">
    <div class="card h-100">
      <div class="card-body">
        <h5 class="card-title">Personal info</h5>
        <p class="card-text text-muted">Change your name, surname, email or password.</p>
        <%= link_to "Edit personal info", edit_profile_path, class: "btn btn-outline-primary" %>
      </div>
    </div>
  </div>

  <div class="col-md-6 col-lg-3">
    <div class="card h-100">
      <div class="card-body">
        <h5 class="card-title">Welcome page</h5>
        <p class="card-text text-muted">See the public list of courses.</p>
        <%= link_to "Back to welcome", root_path, class: "btn btn-outline-secondary" %>
      </div>
    </div>
  </div>
</div>