<div class="d-flex justify-content-between align-items-center mb-3">
  <h1>My courses</h1>
  <%= link_to "New course", new_course_path, class: "btn btn-primary" %>
</div>

<% if @courses.any? %>
  <table class="table table-striped align-middle">
    <thead>
      <tr>
        <th>Code</th>
        <th>Name</th>
        <th>Semester</th>
        <th>Students</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @courses.each do |course| %>
        <tr>
          <td><%= course.code %></td>
          <td><%= course.name %></td>
          <td><%= course.semester %></td>
          <td><%= course.enrollments.size %></td>
          <td class="text-end">
            <%= link_to "View", course, class: "btn btn-sm btn-outline-primary" %>
            <%= link_to "Edit", edit_course_path(course), class: "btn btn-sm btn-outline-secondary" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>You haven't created any courses yet.</p>
<% end %>

<%= link_to "Back to dashboard", instructor_dashboard_path %>