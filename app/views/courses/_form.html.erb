<div class="col-md-6">
  <% if course.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% course.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: course do |f| %>
    <div class="mb-3">
      <%= f.label :code, class: "form-label" %>
      <%= f.text_field :code, class: "form-control", placeholder: "CS101" %>
    </div>
    <div class="mb-3">
      <%= f.label :name, class: "form-label" %>
      <%= f.text_field :name, class: "form-control" %>
    </div>
    <div class="mb-3">
      <%= f.label :semester, class: "form-label" %>
      <%= f.text_field :semester, class: "form-control", placeholder: "Fall 2025" %>
    </div>
    <div class="mb-3">
      <%= f.label :catalog_data, "Catalog data (optional)", class: "form-label" %>
      <%= f.text_area :catalog_data, rows: 4, class: "form-control" %>
    </div>
    <%= f.submit class: "btn btn-primary" %>
  <% end %>
</div>