<h1 class="mb-4">Personal info</h1>

<% if @user.errors.any? %>
  <div class="alert alert-danger col-md-6">
    <ul class="mb-0">
      <% @user.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<div class="row g-4">
  <div class="col-md-6">
    <div class="card">
      <div class="card-body">
        <h5 class="card-title mb-3">Your details</h5>
        <%= form_with model: @user, url: profile_path, method: :patch do |f| %>
          <div class="mb-3">
            <%= f.label :name, class: "form-label" %>
            <%= f.text_field :name, class: "form-control" %>
          </div>
          <div class="mb-3">
            <%= f.label :surname, class: "form-label" %>
            <%= f.text_field :surname, class: "form-control" %>
          </div>
          <div class="mb-3">
            <%= f.label :email_address, "Email", class: "form-label" %>
            <%= f.email_field :email_address, class: "form-control" %>
          </div>
          <%= f.submit "Save details", class: "btn btn-primary" %>
        <% end %>
      </div>
    </div>
  </div>

  <div class="col-md-6">
    <div class="card">
      <div class="card-body">
        <h5 class="card-title mb-3">Change password</h5>
        <%= form_with model: @user, url: profile_password_path, method: :patch do |f| %>
          <div class="mb-3">
            <%= f.label :password_challenge, "Current password", class: "form-label" %>
            <%= f.password_field :password_challenge, class: "form-control" %>
          </div>
          <div class="mb-3">
            <%= f.label :password, "New password", class: "form-label" %>
            <%= f.password_field :password, class: "form-control" %>
            <div class="form-text">At least 8 characters, with an uppercase letter, a lowercase letter and a number.</div>
          </div>
          <div class="mb-3">
            <%= f.label :password_confirmation, "Confirm new password", class: "form-label" %>
            <%= f.password_field :password_confirmation, class: "form-control" %>
          </div>
          <%= f.submit "Change password", class: "btn btn-primary" %>
        <% end %>
      </div>
    </div>
  </div>
</div>

<%= link_to "Back to dashboard", instructor_dashboard_path, class: "d-inline-block mt-4" %>